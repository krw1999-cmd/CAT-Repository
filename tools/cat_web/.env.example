# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit it.

# Gmail address to send FROM (must be the account you generated the App Password for)
GMAIL_USER=your.address@gmail.com

# Gmail App Password (NOT your regular password).
# Generate at: https://myaccount.google.com/apppasswords
# You need 2-Step Verification enabled first.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Address to send reminder emails TO
REMINDER_TO=accounting@waypointadjusting.com

# SMTP settings (defaults work for Gmail — only change if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
